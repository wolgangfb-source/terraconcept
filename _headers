# Cabeceras de Netlify.

# El cotizador es una herramienta interna: fuera de buscadores y sin filtrar
# la URL al navegar hacia afuera.
/cotizador/*
  X-Robots-Tag: noindex, nofollow, noarchive
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY

# Netlify sirve el manifest como application/octet-stream y Chrome lo rechaza
# para instalar la PWA.
/cotizador/manifest.webmanifest
  Content-Type: application/manifest+json
  X-Robots-Tag: noindex, nofollow, noarchive

# El service worker no debe quedar cacheado: es lo que decide como se sirve
# todo lo demas.
/cotizador/sw.js
  Cache-Control: no-cache
  X-Robots-Tag: noindex, nofollow, noarchive
